table _Measures
	lineageTag: 8288e8a6-0f68-4ca5-8efc-3f1d2c9bd1fc

	measure 'Total Cost' =
			
			SUMX(
			    'dw FactSales',
			    'dw FactSales'[OrderQty] * RELATED('dw DimProduct'[StandardCost])
			)
		lineageTag: 7dcb92e2-338e-427b-bb2a-792dab529f9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Sales' = SUM('dw FactSales'[LineTotal])
		lineageTag: 6221db86-dedc-4617-a5f2-564712044de2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Profit' = [Total Sales] - [Total Cost]
		lineageTag: b1f51943-12ae-432f-a321-2e09ca83d850

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales], 0)
		lineageTag: ccecc84d-e5ca-4c9a-9418-084d650c32aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

